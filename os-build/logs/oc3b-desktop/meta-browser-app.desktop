[Desktop Entry]
Type=Application
Version=1.0
Name=Web
GenericName=MetaOS Web Browser
Comment=Browse with the Meta start page
Exec=chromium --no-first-run --app=file:///usr/share/metaos/start/index.html %U
TryExec=chromium
Icon=chromium
Terminal=false
Categories=Network;WebBrowser;GTK;
OnlyShowIn=XFCE;
StartupNotify=true
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
NoDisplay=false
