[Desktop Entry]
Version=1.0
Type=Application
Name=Calendar
Comment=Local calendar (valid .ics in ~/Notes, offline)
Exec=/usr/local/bin/meta-app --title Calendar --app-id calendar --url http://127.0.0.1:18900/calendar.html
TryExec=/usr/local/bin/meta-app
Icon=/usr/share/icons/metaos/128x128/apps/calendar.png
Terminal=false
Categories=Office;Calendar;
OnlyShowIn=XFCE;
StartupNotify=true
StartupWMClass=meta-app
Actions=NewWindow;

[Desktop Action NewWindow]
Name=Open New Window
Exec=/usr/local/bin/meta-app --title Calendar --app-id calendar --url http://127.0.0.1:18900/calendar.html
