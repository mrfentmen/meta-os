# MetaOS 1.0 -- Calamares branding descriptor.
#
# Original assets only: productLogo/productIcon/productWelcome are drawn by
# assets/make_assets.py (ring mark + 5x7 block wordmark). No Apple artwork,
# icons, layouts or fonts are referenced anywhere in this lane.
#
# URLs are deliberately absent. There is no public MetaOS domain yet, and a
# dead "Support"/"Release notes" link in the installer is worse than no link;
# welcome.conf therefore sets showSupportUrl/showReleaseNotesUrl false. When
# the boss names the domain, add the three strings here and flip those two
# keys -- nothing else changes.

componentName: metaos

strings:
    productName:         "MetaOS"
    shortProductName:    "MetaOS"
    version:             "1.0"
    shortVersion:        "1.0"
    versionedName:       "MetaOS 1.0"
    shortVersionedName:  "MetaOS 1.0"
    bootloaderEntryName: "MetaOS"

images:
    productLogo:    "productLogo.png"
    productIcon:    "productIcon.png"
    productWelcome: "productWelcome.png"

# Install slideshow: plain image sequence, one frame every ~2 s during the
# exec phase. Deliberately NOT QML: a QML slideshow needs QtQuick present in
# the live session and a slideshowAPI value, both of which are boot-test
# questions. Images have zero runtime dependencies beyond the PNGs below,
# which ship in this same directory (provision.sh copies the whole tree).
#
# Paths are relative to this branding component directory: upstream
# initSlideshowSettings resolves each entry with
# componentDir.absoluteFilePath(), so "slideshow/slide-01.png" means
# /etc/calamares/branding/metaos/slideshow/slide-01.png on the live system.
# MISSING `slideshow:` IS FATAL: upstream get(doc, "slideshow") throws and
# Branding bails (exit 1) when the key is absent, so this key must stay.
# Generated by make_slides.py in this directory (no fonts, no artwork).
slideshow:
    - "slideshow/slide-01.png"
    - "slideshow/slide-02.png"
    - "slideshow/slide-03.png"

style:
    # Capitalized keys ON PURPOSE. Upstream Branding::styleString looks the
    # style map up by QMetaEnum key name (SidebarBackground, SidebarText,
    # SidebarTextCurrent, SidebarBackgroundCurrent) and the C++ widget
    # sidebar (ProgressTreeDelegate) consumes exactly those. The lowercase
    # sidebarBackground/sidebarTextSelect form most distros ship does not
    # match those lookups (it only warns). KaOS precedent for this form.
    # Palette is the installer spec: blue #1877F2, white #EDF5FF,
    # black #070B16.
    SidebarBackground:        "#070B16"
    SidebarText:              "#EDF5FF"
    SidebarTextCurrent:       "#EDF5FF"
    SidebarBackgroundCurrent: "#1877F2"
