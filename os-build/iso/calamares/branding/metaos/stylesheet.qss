/* MetaOS 1.0 Calamares stylesheet -- intentionally small.
 *
 * Cosmetic only: every rule below is colour/spacing. No rule changes
 * geometry or hides a widget, so a Calamares version bump cannot turn
 * this file into a broken installer. Colours are the installer spec
 * palette only: blue #1877F2, white #EDF5FF, black #070B16.
 */

QWidget {
    background-color: #070B16;
    color: #EDF5FF;
}

QLabel {
    color: #EDF5FF;
    background: transparent;
}

QLabel#heading,
QLabel[heading="true"] {
    color: #EDF5FF;
    font-size: 18px;
}

QPushButton {
    background-color: #1877F2;
    color: #070B16;
    border: 0;
    border-radius: 4px;
    padding: 6px 18px;
    min-width: 96px;
}

QPushButton:disabled {
    background-color: #070B16;
    color: #1877F2;
    border: 1px solid #1877F2;
}

QPushButton#quitButton,
QPushButton[flat="true"] {
    background-color: transparent;
    color: #EDF5FF;
}

QProgressBar {
    border: 1px solid #1877F2;
    border-radius: 3px;
    background-color: #070B16;
    text-align: center;
    color: #EDF5FF;
}

QProgressBar::chunk {
    background-color: #1877F2;
    border-radius: 2px;
}

QListView,
QTreeView,
QTableView {
    background-color: #070B16;
    alternate-background-color: #070B16;
    selection-background-color: #1877F2;
    selection-color: #EDF5FF;
    border: 1px solid #1877F2;
}

QLineEdit,
QPlainTextEdit,
QComboBox,
QSpinBox {
    background-color: #070B16;
    border: 1px solid #1877F2;
    border-radius: 3px;
    padding: 4px;
    color: #EDF5FF;
}

QLineEdit:focus,
QComboBox:focus {
    border-color: #1877F2;
}

QScrollBar:vertical {
    background: #070B16;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #1877F2;
    border-radius: 5px;
    min-height: 24px;
}
