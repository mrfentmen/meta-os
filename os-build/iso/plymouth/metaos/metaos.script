# MetaOS plymouth boot splash (script plugin).
# Palette (frozen studio tokens): ink #070B16, blue #1877F2, paper #EDF5FF.
# Assets live in ImageDir (/usr/share/plymouth/themes/metaos):
#   background.png  1920x1080 splash backdrop (downscaled meta-rays wallpaper)
#   meta-m.png      512px original M mark (white stems + blue chevron)
#   progress.png    560x28 Meta-blue progress bar
#   frames/         32-frame spinning ribbon (480x272 PNGs, downscaled from the
#                   settled studio-loop-smooth set that meta-live.py plays at
#                   16 fps; cycled here at the same cadence, only the Meta
#                   mark and caption are drawn, no cursor: password entry uses
#                   static "*" bullets)
# Provenance: frames generated by generate-frames.py (PIL only), never edited.

Window.SetBackgroundTopColor (0.027, 0.043, 0.086);
Window.SetBackgroundBottomColor (0.027, 0.043, 0.086);

screen.x = Window.GetX ();
screen.y = Window.GetY ();
screen.w = Window.GetWidth ();
screen.h = Window.GetHeight ();

# --- spinning ribbon: the 32-frame set, preloaded and scaled once ---
# Filenames are unpadded (frame-0.png .. frame-31.png) because the script
# language has no zero-padding operator; all 32 Image() references below are
# literal so the theme parses even if dynamic filename building ever changes.
# (Block emitted by generate-frames.py into frames.inc and inlined here so
# the theme stays a single file.)
ribbon.n = 32;
ribbon.i = 0;
ribbon.w = screen.w * 0.42;
ribbon.h = ribbon.w * 272 / 480;
if (ribbon.h > screen.h * 0.42) {
  ribbon.h = screen.h * 0.42;
  ribbon.w = ribbon.h * 480 / 272;
}
ribbon.f = NULL;
ribbon.f[0] = Image ("frames/frame-0.png");
ribbon.f[0] = ribbon.f[0].Scale (ribbon.w, ribbon.h);
ribbon.f[1] = Image ("frames/frame-1.png");
ribbon.f[1] = ribbon.f[1].Scale (ribbon.w, ribbon.h);
ribbon.f[2] = Image ("frames/frame-2.png");
ribbon.f[2] = ribbon.f[2].Scale (ribbon.w, ribbon.h);
ribbon.f[3] = Image ("frames/frame-3.png");
ribbon.f[3] = ribbon.f[3].Scale (ribbon.w, ribbon.h);
ribbon.f[4] = Image ("frames/frame-4.png");
ribbon.f[4] = ribbon.f[4].Scale (ribbon.w, ribbon.h);
ribbon.f[5] = Image ("frames/frame-5.png");
ribbon.f[5] = ribbon.f[5].Scale (ribbon.w, ribbon.h);
ribbon.f[6] = Image ("frames/frame-6.png");
ribbon.f[6] = ribbon.f[6].Scale (ribbon.w, ribbon.h);
ribbon.f[7] = Image ("frames/frame-7.png");
ribbon.f[7] = ribbon.f[7].Scale (ribbon.w, ribbon.h);
ribbon.f[8] = Image ("frames/frame-8.png");
ribbon.f[8] = ribbon.f[8].Scale (ribbon.w, ribbon.h);
ribbon.f[9] = Image ("frames/frame-9.png");
ribbon.f[9] = ribbon.f[9].Scale (ribbon.w, ribbon.h);
ribbon.f[10] = Image ("frames/frame-10.png");
ribbon.f[10] = ribbon.f[10].Scale (ribbon.w, ribbon.h);
ribbon.f[11] = Image ("frames/frame-11.png");
ribbon.f[11] = ribbon.f[11].Scale (ribbon.w, ribbon.h);
ribbon.f[12] = Image ("frames/frame-12.png");
ribbon.f[12] = ribbon.f[12].Scale (ribbon.w, ribbon.h);
ribbon.f[13] = Image ("frames/frame-13.png");
ribbon.f[13] = ribbon.f[13].Scale (ribbon.w, ribbon.h);
ribbon.f[14] = Image ("frames/frame-14.png");
ribbon.f[14] = ribbon.f[14].Scale (ribbon.w, ribbon.h);
ribbon.f[15] = Image ("frames/frame-15.png");
ribbon.f[15] = ribbon.f[15].Scale (ribbon.w, ribbon.h);
ribbon.f[16] = Image ("frames/frame-16.png");
ribbon.f[16] = ribbon.f[16].Scale (ribbon.w, ribbon.h);
ribbon.f[17] = Image ("frames/frame-17.png");
ribbon.f[17] = ribbon.f[17].Scale (ribbon.w, ribbon.h);
ribbon.f[18] = Image ("frames/frame-18.png");
ribbon.f[18] = ribbon.f[18].Scale (ribbon.w, ribbon.h);
ribbon.f[19] = Image ("frames/frame-19.png");
ribbon.f[19] = ribbon.f[19].Scale (ribbon.w, ribbon.h);
ribbon.f[20] = Image ("frames/frame-20.png");
ribbon.f[20] = ribbon.f[20].Scale (ribbon.w, ribbon.h);
ribbon.f[21] = Image ("frames/frame-21.png");
ribbon.f[21] = ribbon.f[21].Scale (ribbon.w, ribbon.h);
ribbon.f[22] = Image ("frames/frame-22.png");
ribbon.f[22] = ribbon.f[22].Scale (ribbon.w, ribbon.h);
ribbon.f[23] = Image ("frames/frame-23.png");
ribbon.f[23] = ribbon.f[23].Scale (ribbon.w, ribbon.h);
ribbon.f[24] = Image ("frames/frame-24.png");
ribbon.f[24] = ribbon.f[24].Scale (ribbon.w, ribbon.h);
ribbon.f[25] = Image ("frames/frame-25.png");
ribbon.f[25] = ribbon.f[25].Scale (ribbon.w, ribbon.h);
ribbon.f[26] = Image ("frames/frame-26.png");
ribbon.f[26] = ribbon.f[26].Scale (ribbon.w, ribbon.h);
ribbon.f[27] = Image ("frames/frame-27.png");
ribbon.f[27] = ribbon.f[27].Scale (ribbon.w, ribbon.h);
ribbon.f[28] = Image ("frames/frame-28.png");
ribbon.f[28] = ribbon.f[28].Scale (ribbon.w, ribbon.h);
ribbon.f[29] = Image ("frames/frame-29.png");
ribbon.f[29] = ribbon.f[29].Scale (ribbon.w, ribbon.h);
ribbon.f[30] = Image ("frames/frame-30.png");
ribbon.f[30] = ribbon.f[30].Scale (ribbon.w, ribbon.h);
ribbon.f[31] = Image ("frames/frame-31.png");
ribbon.f[31] = ribbon.f[31].Scale (ribbon.w, ribbon.h);
ribbon.sprite = Sprite (ribbon.f[0]);
ribbon.sprite.SetPosition (screen.x + (screen.w - ribbon.w) / 2,
                           screen.y + (screen.h - ribbon.h) / 2 - 40, 0);

# --- centered M mark, small, above the ribbon anchor ---
logo.image = Image ("meta-m.png");
logo.w = logo.image.GetWidth ();
logo.h = logo.image.GetHeight ();
logo.target = screen.w / 10;
logo.scale = logo.target / logo.w;
logo.scale = Math.Min (logo.scale, screen.h / 10 / logo.h);
logo.scale = Math.Min (logo.scale, 1);
logo.image = logo.image.Scale (logo.w * logo.scale, logo.h * logo.scale);
logo.sprite = Sprite (logo.image);
logo.sprite.SetPosition (screen.x + (screen.w - logo.image.GetWidth ()) / 2,
                         screen.y + 36, 1);

# --- progress bar under the ribbon ---
bar.image = Image ("progress.png");
bar.sprite = Sprite ();
bar.x = screen.x + (screen.w - bar.image.GetWidth ()) / 2;
bar.y = screen.y + (screen.h + ribbon.h) / 2;
bar.sprite.SetPosition (bar.x, bar.y, 2);
bar.sprite.SetOpacity (0);

# --- loading caption, visible for the whole boot ---
caption.text = Image.Text ("Loading into MetaOS", 0.93, 0.96, 1.0);
caption.sprite = Sprite (caption.text);
caption.sprite.SetPosition (screen.x + (screen.w - caption.text.GetWidth ()) / 2,
                            bar.y - caption.text.GetHeight () - 16, 2);
caption.sprite.SetOpacity (1);

# --- password / message overlays share one centered text sprite ---
prompt.sprite = Sprite ();
prompt.sprite.SetOpacity (0);
bullet.sprites = NULL;

pulse = 0;

fun boot_progress (duration, progress) {
  if (progress > 0) {
    bar.sprite.SetOpacity (1);
    w = Math.Int (bar.image.GetWidth () * progress);
    if (w > 0) {
      clipped = bar.image.Crop (0, 0, w, bar.image.GetHeight ());
      bar.sprite.SetImage (clipped);
    }
  }
}

Plymouth.SetBootProgressFunction (boot_progress);

# Ribbon cadence: one frame per 4 refresh ticks. At the standard 60 Hz
# refresh that is ~15 fps, matching meta-live.py image mode (32 frames at
# 16 fps, same 2 s turn). No cursor sprite is ever created: password entry
# below draws static "*" bullets, so there is no text cursor to flash.
fun on_refresh () {
  pulse = pulse + 1;
  if (Math.Int (pulse / 4) * 4 == pulse) {
    ribbon.i = ribbon.i + 1;
    if (ribbon.i == ribbon.n)
      ribbon.i = 0;
    ribbon.sprite.SetImage (ribbon.f[ribbon.i]);
  }
}

Plymouth.SetRefreshFunction (on_refresh);

fun password_prompt (prompt, bullets) {
  bar.sprite.SetOpacity (0);
  prompt.sprite.SetOpacity (0);
  bullet.sprites = NULL;
  dialog = Image.Text (prompt, 0.93, 0.96, 1.0);
  prompt.sprite.SetImage (dialog);
  prompt.sprite.SetPosition (screen.x + (screen.w - dialog.GetWidth ()) / 2,
                             bar.y - dialog.GetHeight () - 24, 3);
  prompt.sprite.SetOpacity (1);
  if (bullets > 0) {
    dot = Image.Text ("*", 0.93, 0.96, 1.0);
    start = screen.x + screen.w / 2 - bullets * dot.GetWidth () / 2;
    for (i = 0; i < bullets; i++) {
      bullet.sprites[i] = Sprite (dot);
      bullet.sprites[i].SetPosition (start + i * dot.GetWidth (), bar.y, 4);
    }
  }
}

Plymouth.SetDisplayPasswordFunction (password_prompt);

fun normal_state () {
  prompt.sprite.SetOpacity (0);
  bullet.sprites = NULL;
  bar.sprite.SetOpacity (0);
}

Plymouth.SetDisplayNormalFunction (normal_state);

fun show_message (msg) {
  text = Image.Text (msg, 0.93, 0.96, 1.0);
  prompt.sprite.SetImage (text);
  prompt.sprite.SetPosition (screen.x + (screen.w - text.GetWidth ()) / 2,
                             screen.y + screen.h - text.GetHeight () - 60, 3);
  prompt.sprite.SetOpacity (1);
}

Plymouth.SetMessageFunction (show_message);

fun hide_message (msg) {
  prompt.sprite.SetOpacity (0);
}

Plymouth.SetHideMessageFunction (hide_message);

fun on_quit () {
  caption.sprite.SetOpacity (0);
}

Plymouth.SetQuitFunction (on_quit);
