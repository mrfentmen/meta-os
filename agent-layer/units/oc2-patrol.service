[Unit]
Description=OC2 agent layer: patrol cycle (bounded run at login + timer)
After=network-online.target oc2-queue.service
Wants=network-online.target
Requires=oc2-queue.service

[Service]
Type=oneshot
EnvironmentFile=%h/.config/oc2-agent/env
ExecStart=/usr/bin/python3 ${OC2_CHECKOUT}/server/queue/patrol.py --max-checks ${OC2_PATROL_MAX_CHECKS} --reserve-usd ${OC2_PATROL_RESERVE_USD}

[Install]
WantedBy=default.target
