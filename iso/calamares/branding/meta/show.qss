/* MetaOS Calamares slideshow.
   Same ink-black and Meta blue as the splash, so install looks like boot.
   No artwork is referenced: this is type and colour only. */

QWidget {
    background-color: #070B16;
    color: #EDF5FF;
    font-family: "DejaVu Sans", sans-serif;
}

#mainText {
    font-size: 26px;
    font-weight: bold;
    color: #EDF5FF;
    margin-bottom: 12px;
}

#secondaryText {
    font-size: 14px;
    color: rgba(237, 245, 255, 0.62);
    line-height: 150%;
}
