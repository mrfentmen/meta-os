  },
  {
    "id": "status-checker",
    "doc": "os-build/BUFFY_ISO_STATUS.md",
    "pattern": "static checker\\s+(\\d+) passed",
    "source": "checker"
  },
  {
    "id": "status-doctor",
    "doc": "os-build/BUFFY_ISO_STATUS.md",
    "pattern": "(\\d+) passed against an",
    "source": "doctor"
  },
  {
    "id": "handoff-checks",
    "doc": "os-build/ISO_LANE_HANDOFF.md",
    "pattern": "(\\d+) static checks",
    "source": "checker"
  },
  {
    "id": "handoff-tests",
    "doc": "os-build/ISO_LANE_HANDOFF.md",
    "pattern": "(\\d+) test files",
    "source": "tests"
  },
  {
    "id": "apps-launchers",
    "doc": "iso/apps/README.md",
