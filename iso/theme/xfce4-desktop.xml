<?xml version="1.0" encoding="UTF-8"?>
<!-- Default Xfce desktop channel: one backdrop, the lane's wallpaper.
     Xfce writes per-monitor keys on first login; this is the shipped
     default, and the user's own channel wins once they change it. -->
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitor0" type="empty">
        <property name="workspace0" type="empty">
          <property name="last-image" type="string" value="/usr/share/metaos/theme/meta-wallpaper.png"/>
          <property name="image-style" type="int" value="5"/>
        </property>
      </property>
    </property>
  </property>
</channel>
