# Meta Trio / Meta OS stack — environment template.
# Copy to .env (or export in the shell) and fill in values.
# Every value below is empty or a placeholder: nothing here is a secret.
# Sources: README.md, server/README.md, server/queue/README.md, relay/README.md, run-stack.sh.

# --- Trio app server (server/README.md, server/server.mjs, server/model.mjs) ---
# Listen port for `node server/server.mjs`. Default 8080.
PORT=
# The model key slot. Set by the operator in the server environment ONLY —
# never in a request, a commit, or a log.
SPARK_API_KEY=
# Test-phase gate: `1` opens live model calls. Leave unset during the build.
ASSESS_LIVE_MODEL=
# NASA FIRMS map key (free). Without it /api/fires answers 503.
FIRMS_MAP_KEY=

# --- OS queue path (server/README.md, server/queue.mjs, run-stack.sh) ---
# `1` enables the queue path in /api/assess; unset skips it (direct path alone).
TRIO_QUEUE_ENABLED=
# Queue service base URL, e.g. http://127.0.0.1:8935. Server-side only.
TRIO_QUEUE_URL=
# Local port for `python3 server/queue/queue_service.py` (run-stack.sh default 8935).
QUEUE_PORT=

# --- Queue store (server/queue/README.md, server/queue/trio_store.py) ---
# Upstash store host (bare host or full REST URL). Required for the Redis path.
TRIO_UPSTASH_HOST=
# Full store base-URL override (wins over TRIO_UPSTASH_HOST).
RELAY_URL=
# Job namespace in the store. Default `trio`; proofs use a scratch namespace.
TRIO_JOB_NS=
# `local` forces the labelled SQLite fallback (tests/dev).
TRIO_STORE=
# Path of the fallback SQLite file (default beside the modules; gitignored).
TRIO_LOCAL_DB=

# --- Meta Nuntius relay (relay/README.md, relay/relay.mjs) ---
# Relay listen port. Default 8787.
RELAY_PORT=
# If set, lines are appended to this JSONL file and reloaded on boot. Unset = in-memory only.
RELAY_STORE_FILE=
# When set, trio_agent.py posts a NOTIFY line per finished job (topic trio-result). Fire-and-forget.
TRIO_RELAY_URL=

# --- Resident agent transport (server/queue/README.md, server/queue/spark_gen.py) ---
# `1` selects the DEV helper transport (vaulted key + own guardrail). Sandbox-only; never auto-selected.
TRIO_SPARK_VIA_HELPER=

# --- Agent crew / patrol (server/queue/README.md) ---
# Where the crew's records live. Default server/queue/crew-data/ (gitignored).
TRIO_CREW_DATA_DIR=
# SIMULATED dispatch endpoint. Default http://127.0.0.1:8935/dispatch-simulated. Loopback-only.
TRIO_CREW_DISPATCH_URL=
# Budget reserve in USD: at or below this much remaining test budget, patrol pauses. Default 5.
TRIO_CREW_BUDGET_RESERVE_USD=

# --- Model capability flags (README.md; stub-tested, live runs owed) ---
# `1` wires the review-reader swap behind this flag.
TRIO_REVIEW_WONDER=
# `1` enables SAM-segmentation patrol wiring.
TRIO_SAM_SEGMENT=
# Judge flag with fallback.
TRIO_JUDGE_MODEL=

# --- Autonomous supervisor tunables (server/queue/supervisor.py; all have built-in defaults) ---
TRIO_SUPERVISOR_PATROL_STALE_S=
TRIO_SUPERVISOR_INCIDENT_STUCK_S=
TRIO_SUPERVISOR_BUDGET_WARN_FRACTION=

# --- Model receipts (server/queue/models.py) ---
# Receipts file path; default beside the module when unset.
METAOS_MODEL_RECEIPTS=
