.sentinel-cron.lock
server/queue/crew-data/
# Real env files are never committed; only .env.example is tracked.
.env
# Build outputs (never commit; rebuild from source)
kernel/target/
os-build/userspace/user/target/
*.bin
*.elf
*.ppm
os-build/logs/*.ppm
os-build/logs/qemu-monitor.log
/target/
os-build/userspace/user/target/
kernel/target/

# Aegis raw reports are local until secret triage is finished
os-build/aegis/SECRETS.json
os-build/aegis/SECRETS.md
os-build/aegis/r11/run-secrets.txt

# Local-only deploy staging (rebuilt by os/docs/deploy-trio-frontend.sh; never commit)
.pages-trio-dist/
.wrangler/

# Reference repos cloned for study (plan/PLAN.md §6). Not dependencies.
refs/

# Machine-local build output: gigabytes, rebuilt from source, never committed
os-build/iso/output/
os-build/rk007/disk.img
os-build/rk007/image-builder/target/
.rk007/

# Runtime state and scratch (rewritten every run; the receipts that matter are
# the ones a report cites, not these working files)
runs/
memory/
os-build/handsfree/jobs/
os-build/handsfree/approval-drill/

# Per-program linker scripts are generated by build_userspace.py from link-base.ld
# (see its header: "working-tree artifacts: do not hand-edit, do not commit")
os-build/userspace/user/link-*.ld
!os-build/userspace/user/link-base.ld

# macOS
.DS_Store

# handsfree inbox is a working queue: the runner consumes it, so it is
# empty or rebuilt on every pass (receipts are the record, not this)
os-build/handsfree/inbox.txt
os-build/handsfree/inbox.txt.done
os-build/handsfree/inbox.txt.refusals.jsonl
