.sentinel-cron.lock
server/queue/crew-data/
# Real env files are never committed; only .env.example is tracked.
.env
# Build outputs (never commit; rebuild from source)
kernel/target/
os-build/userspace/user/target/
*.bin
*.elf
*.ppm
os-build/logs/*.ppm
os-build/logs/qemu-monitor.log
/target/
os-build/userspace/user/target/
kernel/target/

# Aegis raw reports are local until secret triage is finished
os-build/aegis/SECRETS.json
os-build/aegis/SECRETS.md
os-build/aegis/r11/run-secrets.txt

# Local-only deploy staging (rebuilt by os/docs/deploy-trio-frontend.sh; never commit)
.pages-trio-dist/
.wrangler/

# Reference repos cloned for study (plan/PLAN.md §6). Not dependencies.
refs/

# Generated icon sheets (regenerate with app-icons.py / settings-symbols.py)
os-build/captures/app-icons-*/

# Agent run ledgers and per-agent memory are runtime state; re-created by running.
runs/
memory/

# Local bus state (R2-T3): file-backed store defaults outside the tree; never commit it if pointed inside
bus-data/

# macOS metadata created by Finder, never part of the tree
.DS_Store

# ISO build output and machine images: rebuilt by os-build/iso/* and os-build/rk007/*
os-build/iso/output/
os-build/rk007/image-builder/target/
os-build/rk007/disk.img
*.img
.rk007/

# Linker scripts the userspace build generates next to its Cargo manifest
os-build/userspace/user/link-*.ld

# Queued jobs are runtime state; the receipts and run records are the evidence
os-build/handsfree/jobs/*.job.json
