#!/bin/sh
# metaos-secrets-sweep (OS-012): prove a built Meta OS rootfs ships
# zero credentials before the image is assembled.
#
# Usage: sh metaos-secrets-sweep <rootfs-dir>
# Exit 0: clean. Exit 1: findings printed, one FINDING line each.
# Exit 2: usage error (wrong args, rootfs dir missing).
#
# Scope, stated plainly: this is the OS-012 gate, not a general
# secret scanner. It checks exactly the credential shapes the
# firstboot flow owns:
#   - any file at all under etc/metaos/ (the image must carry no
#     credential files; build-image.sh creates that directory
#     empty, mode 700, and firstboot fills it on the machine)
#   - a file named token, job-secret, or secrets.env under etc/,
#     root/, home/, or opt/ (the places Meta OS credential
#     files could land)
#   - a literal value for MUSE_RELAY_URL, META_MODEL_API_KEY, or
#     UPSTASH_TOKEN, or a keyring-format default:<hex> line, in
#     any regular file (a variable expansion like $RELAY_URL
#     does not count: the firstboot program itself contains
#     those and must sweep clean)
#   - OS-059: any file under opt/relay/mcp-gateway that is not
#     the bake allowlist (gateway.py, backends.json, and the
#     .metaos-gateway-bake stamp). The bake copies only those
#     three, so a venv, a servers/ runtime tree, a debug log,
#     a database, a backup, or an env file baked beside
#     /opt/relay is a finding even when it carries no literal
#     secret value: it is credential-adjacent estate that the
#     image must not carry.
# It does NOT scan for other vendors' key shapes: the repo
# payload carries adversarial eval fixtures with planted fake
# keys, and flagging those would fail every build on purpose.
# General secret hygiene stays with the INT-011 grep pass.
set -u

if [ $# -ne 1 ]; then
    echo "usage: metaos-secrets-sweep <rootfs-dir>" >&2
    exit 2
fi
ROOT=${1%/}
if [ ! -d "$ROOT" ]; then
    echo "metaos-secrets-sweep: not a directory: $1" >&2
    exit 2
fi

TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT INT TERM

# 1. Any file under etc/metaos is a baked credential file.
if [ -d "$ROOT/etc/metaos" ]; then
    find "$ROOT/etc/metaos" -type f -print \
        | sed 's|^|FINDING credential file under etc/metaos: |' >> "$TMP"
fi

# 2. Credential filenames where Meta OS files could land.
for base in etc root home opt; do
    if [ -d "$ROOT/$base" ]; then
        find "$ROOT/$base" -type f \
            \( -name token -o -name job-secret -o -name secrets.env \) \
            -print \
            | sed 's|^|FINDING credential filename: |' >> "$TMP"
    fi
done

# 3. Literal secret values in any regular file. Recursive grep
# reads regular files only and skips proc/sys/dev trees.
PATTERN='MUSE_RELAY_URL=https?://[^[:space:]]|META_MODEL_API_KEY=[^[:space:]$][^[:space:]]*|UPSTASH_TOKEN=[^[:space:]$][^[:space:]]*|default:[0-9a-f]{32,}'
grep -rInE -I --exclude-dir=proc --exclude-dir=sys --exclude-dir=dev \
    -- "$PATTERN" "$ROOT" 2>/dev/null \
    | sed 's|^|FINDING literal secret assignment: |' >> "$TMP"

# 4. OS-059: baked gateway dir holds exactly the allowlist.
if [ -d "$ROOT/opt/relay/mcp-gateway" ]; then
    find "$ROOT/opt/relay/mcp-gateway" -type f -print \
        | while IFS= read -r file; do
            case "$file" in
                */opt/relay/mcp-gateway/gateway.py|*/opt/relay/mcp-gateway/backends.json|*/opt/relay/mcp-gateway/.metaos-gateway-bake) ;;
                *) echo "FINDING non-allowlisted file in baked gateway dir: $file" ;;
            esac
        done >> "$TMP"
fi

COUNT=$(wc -l < "$TMP" | tr -d ' ')
cat "$TMP"
if [ "$COUNT" -gt 0 ]; then
    echo "metaos-secrets-sweep: $COUNT finding(s) in $ROOT"
    exit 1
fi
echo "metaos-secrets-sweep: clean: $ROOT"
exit 0
