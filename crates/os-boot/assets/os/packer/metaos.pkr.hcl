# os/packer/metaos.pkr.hcl -- OS-007 primary pipeline (first light).
#
# Scripted Packer + QEMU unattended build of the Meta OS image from this
# repo's os/ tree. One command drives it: os/build-packer.sh (run from
# the repo root). This template alone is not the pipeline: the wrapper
# resolves the ISO, generates the build preseed and the build password,
# and renames the output to metaos-<date>.img + .sha256.
#
# What this template does, in order:
#   1. Boots the Debian 12 (bookworm) amd64 netinst ISO with the build
#      preseed served over Packer's HTTP server (os/preseed.cfg with
#      only the relay password line replaced by a random per-build
#      hash; the committed preseed keeps the locked "*" password).
#   2. Installs the os/ glue into the installed system: systemd units
#      + relay.target, firstboot program, image tools, getty autologin
#      drop-ins, /etc/metaos-version stamp. Same unit list and same
#      stamp format as the debootstrap route (os/build-image.sh).
#   2b. OS-059 gateway bake: the same allowlist as the other
#      routes (gateway.py plus backends.json only) from the
#      workspace mcp-gateway checkout, reached as
#      ../../../mcp-gateway relative to the os/ working dir
#      build-packer.sh runs Packer from. A missing source file
#      fails the build at the file provisioner, same refusal
#      shape as the other routes. The stamp records the bake
#      date plus the sha256 of both baked files.
#   3. Shuts the VM down; the wrapper renames the raw disk to
#      metaos-<date>.img and writes its .sha256 beside it.
#
# What it does NOT do (follow-ups, not silent gaps):
#   - Payload bake is OS-011: /opt/relay is not populated here, so the
#     crew units wait for firstboot exactly as the unit guards say
#     (relay-bus.service skips without /etc/metaos/secrets.env).
#   - The build password is random per build, generated by the
#     wrapper, never written to the repo, and discarded by the
#     wrapper's trap. Locking it at image level is OS-012 follow-up.
#   - No Packer build has been run from this template yet: the sandbox
#     has no packer, no qemu, and no /dev/kvm, so `packer validate`
#     and the build itself are UNPROVEN here. Do not claim this
#     pipeline works until a build host runs os/build-packer.sh end
#     to end and the image boots (OS-019 harness). Second-run package
#     reproducibility is likewise unproven until two builds are
#     compared.
#   - The ISO version is resolved at build time from the cdimage
#     listing (no version pinned in this repo); its checksum is
#     verified by Packer against the publisher's SHA256SUMS file at
#     build time, not against a hash recorded here.

packer {
  required_plugins {
    qemu = {
      version = ">= 1.0.0"
      source  = "github.com/hashicorp/qemu"
    }
  }
}

variable "iso_url" {
  type        = string
  description = "Debian 12 bookworm amd64 netinst ISO URL, resolved by os/build-packer.sh from the cdimage listing. No default: a pinned version here would rot."
}

variable "iso_checksum" {
  type        = string
  default     = "file:https://cdimage.debian.org/debian-cd/current/amd64/iso-cd/SHA256SUMS"
  description = "Publisher checksum file Packer verifies the ISO against at build time. Version independent: it lives beside the current ISO."
}

variable "ssh_password" {
  type        = string
  sensitive   = true
  description = "Random per-build relay password, generated by os/build-packer.sh and passed via a var file in os/work/ (gitignored, removed by trap). Never a committed value."
}

variable "image_date" {
  type        = string
  default     = "dev"
  description = "Build date stamped into /etc/metaos-version. os/build-packer.sh passes YYYY-MM-DD; 'dev' only marks a hand run without the wrapper."
}

source "qemu" "metaos" {
  iso_url           = var.iso_url
  iso_checksum      = var.iso_checksum
  output_directory  = "work/packer-out"
  vm_name           = "metaos"
  format            = "raw"
  disk_size         = 8192
  memory            = 2048
  cpus              = 2
  headless          = true
  http_directory    = "work/packer-http"
  boot_wait         = "10s"
  boot_command = [
    "<esc><wait>",
    "auto url=http://{{ .HTTPIP }}:{{ .HTTPPort }}/preseed-build.cfg ",
    "hostname=metaos domain=local ",
    "<enter>"
  ]
  ssh_username      = "relay"
  ssh_password      = var.ssh_password
  ssh_timeout       = "30m"
  shutdown_command  = "echo '${var.ssh_password}' | sudo -S shutdown -P now"
}

build {
  sources = ["source.qemu.metaos"]

  provisioner "file" {
    source      = "services"
    destination = "/tmp/metaos/services"
  }

  provisioner "file" {
    source      = "firstboot"
    destination = "/tmp/metaos/firstboot"
  }

  provisioner "file" {
    source      = "bin"
    destination = "/tmp/metaos/bin"
  }

  # OS-059: gateway daemon plus catalog only. The whole
  # checkout is never copied: no .venv, no servers/ runtimes,
  # no debug/ logs, no databases, no backups.
  provisioner "file" {
    source      = "../../../mcp-gateway/gateway.py"
    destination = "/tmp/metaos/gateway/"
  }

  provisioner "file" {
    source      = "../../../mcp-gateway/backends.json"
    destination = "/tmp/metaos/gateway/"
  }

  provisioner "shell" {
    execute_command = "echo '${var.ssh_password}' | sudo -S -E bash '{{ .Path }}'"
    inline = [
      "install -m 644 /tmp/metaos/services/*.service /tmp/metaos/services/*.timer /tmp/metaos/services/relay.target /etc/systemd/system/",
      "install -m 755 /tmp/metaos/firstboot/metaos-firstboot /tmp/metaos/bin/metaos-boot-checklist /tmp/metaos/bin/metaos-update /usr/local/bin/",
      "mkdir -p /opt/relay/mcp-gateway",
      "install -m 644 /tmp/metaos/gateway/gateway.py /tmp/metaos/gateway/backends.json /opt/relay/mcp-gateway/",
      "echo \"gateway-bake ${var.image_date}\" > /opt/relay/mcp-gateway/.metaos-gateway-bake",
      "echo \"source workspace mcp-gateway checkout\" >> /opt/relay/mcp-gateway/.metaos-gateway-bake",
      "(cd /opt/relay/mcp-gateway && sha256sum gateway.py backends.json >> .metaos-gateway-bake)",
      "chown -R relay:relay /opt/relay/mcp-gateway",
      "mkdir -p /var/lib/metaos/artifacts",
      "echo \"artifact-store-root /var/lib/metaos/artifacts\" > /var/lib/metaos/artifacts/.metaos-artifact-store",
      "echo \"git-init on first deposit by mos/artifact_store.py\" >> /var/lib/metaos/artifacts/.metaos-artifact-store",
      "chown -R relay:relay /var/lib/metaos/artifacts",
      "mkdir -p /var/lib/metaos/memory",
      "echo \"memory-store-root /var/lib/metaos/memory\" > /var/lib/metaos/memory/.metaos-memory-store",
      "echo \"namespaces ensured at boot by relay-memory.service\" >> /var/lib/metaos/memory/.metaos-memory-store",
      "chown -R relay:relay /var/lib/metaos/memory",
      "mkdir -p /var/lib/metaos/skills",
      "echo \"skills-collection-root /var/lib/metaos/skills\" > /var/lib/metaos/skills/.metaos-skills-root",
      "echo \"populated by a later install step, never baked with skill content\" >> /var/lib/metaos/skills/.metaos-skills-root",
      "chown -R relay:relay /var/lib/metaos/skills",
      "mkdir -p /etc/systemd/system/relay.target.wants /etc/systemd/system/multi-user.target.wants",
      "for u in relay-dashboard.service relay-bus.service relay-jobs.service relay-overseer.timer relay-ready.service relay-watchdog.service relay-brief.service relay-watchman.service relay-uplink.service relay-mcp-gateway.service relay-memory.service metaos-firstboot.service; do if [ \"$u\" = \"metaos-firstboot.service\" ]; then ln -sf \"/etc/systemd/system/$u\" \"/etc/systemd/system/multi-user.target.wants/$u\"; else ln -sf \"/etc/systemd/system/$u\" \"/etc/systemd/system/relay.target.wants/$u\"; fi; done",
      "ln -sf /etc/systemd/system/relay-overseer.service /etc/systemd/system/relay.target.wants/relay-overseer.service",
      "for g in getty@tty1 serial-getty@ttyS0; do d=\"/etc/systemd/system/$g.d\"; mkdir -p \"$d\"; printf '[Service]\\nExecStart=\\nExecStart=-/sbin/agetty --autologin relay --noclear %I $TERM\\n' > \"$d/autologin.conf\"; done",
      "mkdir -p /etc/metaos",
      "chmod 700 /etc/metaos",
      "echo \"metaos-${var.image_date} (debian 12 bookworm, stock kernel)\" > /etc/metaos-version",
      "rm -rf /tmp/metaos"
    ]
  }
}
