[Unit]
Description=Meta Custos patrol (night watch for machines: KEV feed, certificate expiry, service liveness, exposure)
After=network-online.target relay-bus.service
Wants=network-online.target relay-bus.service
PartOf=relay.target

[Service]
Type=oneshot
User=relay
Group=relay
WorkingDirectory=/opt/relay
EnvironmentFile=-/etc/metaos/custos.env
ExecStart=/usr/local/bin/metaos-custos

[Install]
WantedBy=relay.target
