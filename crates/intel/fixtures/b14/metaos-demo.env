# Meta OS demo thresholds profile (DEM-013, shared with OS-038).
#
# DEMO ONLY. This file is never loaded by production: the production
# watchdog reads intel/thresholds.py defaults (stall 10 min). The
# demo loop loads this file and only this file, so the demo's
# shortened windows can never leak into a production run — and
# intel/thresholds.py itself is untouched by the demo profile.
#
# How to load it for the demo loop (thresholds.py reads these
# variables once at import time, so they must be set before the
# watchdog process starts):
#   set -a; . intel/metaos-demo.env; set +a
#   python3 intel/watchdog.py --loop --interval 5 --announce
# OS-038's unit drop-in loads this same file via EnvironmentFile.
#
# Every WATCHDOG_* variable thresholds.py knows is listed here,
# even the unchanged ones, so the demo profile is complete and
# there is no question about which value is live in the demo.
# Changed for the demo: the two stall windows only.
# DEMO_TICK_INTERVAL_SECONDS is not a thresholds.py variable:
# it is the demo loop's --interval argument, recorded here so
# the operator runs the loop the measurement (DEM-012) assumes.

# Demo: a silent worker is a stall after 1 minute, not 10.
# Production default: 10. Shortened so Shot 8's catch lands
# seconds after the cue instead of ten minutes into the demo.
WATCHDOG_STALL_MINUTES=1

# Demo: a worker alive but stuck is a stall after 1 minute.
# Production default: 10. Same demo reason as above.
WATCHDOG_PROGRESS_STALL_MINUTES=1

# Unchanged from production: lease-risk still warns 5 min
# before expiry after 2 quiet minutes. The demo job's lease
# is 30 min, so this never fires during Shot 7-8; it stays
# listed so the profile is complete, not partial.
WATCHDOG_LEASE_RISK_WINDOW_MINUTES=5
WATCHDOG_LEASE_RISK_QUIET_MINUTES=2

# Unchanged: one alert per dedupe key per 30 min, so a
# rehearsal re-run on a shared store does not double-alert.
WATCHDOG_ALERT_DEDUPE_COOLDOWN_MINUTES=30

# Unchanged: silent-room info record after 60 quiet minutes.
WATCHDOG_SILENT_ROOM_MINUTES=60

# Unchanged: watchdog beat TTL, 300 s (five 60 s loop ticks
# in production; the demo loop ticks faster, so the beat
# only ever looks fresher than production).
WATCHDOG_BEAT_TTL_SECONDS=300

# Unchanged: tick budget guard.
WATCHDOG_TICK_PAGE_SIZE=1000
WATCHDOG_TICK_MAX_MESSAGES=1000

# Demo loop tick interval in seconds (operator's --interval,
# not a thresholds.py variable). DEM-012's measurement ticks
# every 5 s, and the live loop must tick at least this fast
# for the measured catch to hold on stage.
DEMO_TICK_INTERVAL_SECONDS=5
